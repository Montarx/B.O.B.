# Copy to .env and fill in only what you actually use.
# .env is gitignored. Never commit real keys.
#
# B.O.B. runs fully local without any of these. They exist only for the
# optional cloud adapters.

# --- Optional cloud LLM / vision adapters ---
# BOB_OPENAI_API_KEY=
# BOB_ANTHROPIC_API_KEY=

# --- Optional skills (Phase 9) ---
# BOB_WEATHER_API_KEY=

# --- Config overrides (BOB__SECTION__KEY) -----------------------------------
# Any setting can be overridden from the environment, which is handy for
# one-off runs and CI. Values are parsed as JSON when possible.
#
# BOB__LOGGING__LEVEL=DEBUG
# BOB__LLM__PROVIDER=ollama
# BOB__LLM__MODEL=qwen2.5:14b-instruct
# BOB__UI__REDUCED_MOTION=true

# --- Where B.O.B. stores logs, models, memory and the audit trail -----------
# Defaults to the OS user-data directory. Override for a portable install.
# BOB_HOME=
